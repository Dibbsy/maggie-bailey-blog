---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const latest = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4);
---

<!doctype html>
<html lang="en-AU">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.intro {
				text-align: center;
				padding: 1em 0 2em;
			}
			.intro h1 {
				margin-bottom: 0.2em;
			}
			.intro p {
				max-width: 34em;
				margin: 0.5em auto;
			}
			.dogs {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1rem;
				margin: 1.5em 0 2.5em;
			}
			.dog {
				background: #fff;
				border-radius: 16px;
				padding: 1em 1.2em;
				box-shadow: 0 2px 8px rgba(var(--black), 6%);
			}
			.dog h3 {
				margin: 0 0 0.3em;
			}
			.dog p {
				margin: 0;
				font-size: 0.95em;
			}
			.latest {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1.5rem;
				list-style: none;
				padding: 0;
			}
			.more {
				text-align: center;
				margin-top: 2em;
			}
			@media (max-width: 720px) {
				.dogs,
				.latest {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<h1>🐾 Maggie &amp; Bailey</h1>
				<p>
					Hello, humans! We're two dogs who live with our Mum and Dad, and we've taken over the
					family blog. Several times a week we tell you what <em>really</em> goes on in our house.
				</p>
			</section>

			<section class="dogs">
				<div class="dog">
					<h3>🎾 Maggie</h3>
					<p>Ball enthusiast. Friend to every child. Will lick you whether you like it or not.</p>
				</div>
				<div class="dog">
					<h3>💨 Bailey</h3>
					<p>Professional zoomer. Only races dogs his own size, because he has standards.</p>
				</div>
			</section>

			<h2>Latest from our paws</h2>
			{latest.length === 0 && <p>Our first post is coming soon. We're warming up the paws.</p>}
			<ul class="latest">
				{
					latest.map((post) => (
						<li>
							<PostCard post={post} />
						</li>
					))
				}
			</ul>
			<p class="more"><a href="/blog">See every post →</a></p>
		</main>
		<Footer />
	</body>
</html>
