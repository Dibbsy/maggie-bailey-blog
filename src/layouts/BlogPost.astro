---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Byline from '../components/Byline.astro';

type Props = Omit<CollectionEntry<'blog'>['data'], 'author'> & {
	author?: CollectionEntry<'blog'>['data']['author'];
	showMeta?: boolean;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	heroAlt,
	author = 'both',
	showMeta = true,
} = Astro.props;
---

<html lang="en-AU">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				max-width: min(100%, 1020px);
				max-height: 75vh;
				width: auto;
				height: auto;
				border-radius: 16px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0.4em 0 0.5em 0;
				line-height: 1.15;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <img src={heroImage} alt={heroAlt ?? ''} loading="eager" />}
				</div>
				<div class="prose">
					<div class="title">
						{
							showMeta && (
								<div class="date">
									<FormattedDate date={pubDate} />
									{updatedDate && (
										<div class="last-updated-on">
											Last updated on <FormattedDate date={updatedDate} />
										</div>
									)}
								</div>
							)
						}
						<h1>{title}</h1>
						{showMeta && <Byline author={author} />}
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
